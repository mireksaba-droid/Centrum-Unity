rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Practitioners - served by /api/practitioners to avoid leaking PINs
    match /practitioners/{practitionerId} {
      allow read, write: if false;
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true; // Temporarily unlocked for AI Studio dev server. Lock to 'if false' in production with a service account.
    }

    match /groupEvents/{eventId} {
      allow read: if true;
      allow write: if true; // Temporarily unlocked for AI Studio dev server. Lock to 'if false' in production with a service account.
    }

    match /eventRegistrations/{regId} {
      allow read: if true;
      allow write: if true; // Temporarily unlocked for AI Studio dev server. Lock to 'if false' in production with a service account.
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
