# GoPay
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_ENV=sandbox                # sandbox (výchozí) nebo production
# GOPAY_API_URL=                 # volitelně vlastní URL brány (přebije GOPAY_ENV)

# Cron (výzvy k platbě u odložených rezervací)
CRON_SECRET=

# AI chat
GEMINI_API_KEY=

# SMTP e-maily (webkitty.eu / centrumunity.cz)
SMTP_HOST=smtp.centrumunity.cz   # odchozí server (Outgoing Server)
SMTP_PORT=465                    # 465 = SSL/TLS (doporučeno), nebo 587 = STARTTLS
SMTP_USER=info@centrumunity.cz   # celá e-mailová adresa schránky (Username)
SMTP_PASS=                       # heslo ke schránce info@centrumunity.cz
FROM_EMAIL=info@centrumunity.cz  # odesílatel (musí být na vaší doméně)

# App secrets
JWT_SECRET=
